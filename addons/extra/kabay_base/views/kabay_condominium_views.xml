<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kabay_condominium_list" model="ir.ui.view">
        <field name="name">kabay.condominium.list</field><field name="model">kabay.condominium</field>
        <field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="company_id"/><field name="building_count"/><field name="apartment_count"/><field name="active"/></list></field>
    </record>
    <record id="view_kabay_condominium_form" model="ir.ui.view">
        <field name="name">kabay.condominium.form</field><field name="model">kabay.condominium</field>
        <field name="arch" type="xml"><form><sheet><field name="active" invisible="1"/><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="code"/><field name="company_id"/><field name="manager_id"/></group><group><field name="street"/><field name="street2"/><field name="city"/><field name="state_id"/><field name="zip"/><field name="country_id"/></group></group><notebook><page string="Edificios"><field name="building_ids"><list editable="bottom"><field name="name"/><field name="code"/><field name="active"/></list></field></page><page string="Notas"><field name="notes"/></page></notebook></sheet><chatter/></form></field>
    </record>
    <record id="view_kabay_condominium_search" model="ir.ui.view">
        <field name="name">kabay.condominium.search</field><field name="model">kabay.condominium</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="code"/><field name="company_id"/><filter name="archived" string="Archivados" domain="[('active','=',False)]"/></search></field>
    </record>
    <record id="action_kabay_condominium" model="ir.actions.act_window"><field name="name">Condominios</field><field name="res_model">kabay.condominium</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_kabay_condominium_search"/></record>
</odoo>
