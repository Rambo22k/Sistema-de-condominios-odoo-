    <record id="view_kabay_batch_search" model="ir.ui.view"><field name="name">kabay.billing.batch.search</field><field name="model">kabay.billing.batch</field><field name="arch" type="xml"><search><field name="name"/><field name="condominium_id"/><field name="state"/><filter name="prepared" string="Preparados" domain="[('state','=','prepared')]"/><filter name="group_condo" string="Condominio" context="{'group_by':'condominium_id'}"/><filter name="group_state" string="Estado" context="{'group_by':'state'}"/></search></field></record>
