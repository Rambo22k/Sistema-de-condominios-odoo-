  <menuitem id="menu_kabay_reports_installments" name="Cuotas" parent="menu_kabay_reports_root" action="action_kabay_report_installments" sequence="21" groups="kabay_base.group_kabay_manager,kabay_base.group_kabay_finance"/>
  <menuitem id="menu_kabay_reports_deposits" name="Depósitos declarados" parent="menu_kabay_reports_root" action="action_kabay_report_deposits" sequence="22" groups="kabay_base.group_kabay_manager,kabay_base.group_kabay_finance"/>
  <menuitem id="menu_kabay_reports_apartments" name="Apartamentos" parent="menu_kabay_reports_root" action="action_kabay_report_apartments" sequence="30" groups="kabay_base.group_kabay_manager,kabay_base.group_kabay_management,kabay_base.group_kabay_reception,kabay_base.group_kabay_maintenance"/>
