        <field name="name">Aviso Kabays: publicaciones y vencimientos</field>
        <field name="model_id" ref="model_kabay_notice"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_publication_states()</field>
        <field name="user_id" ref="base.user_root"/>
