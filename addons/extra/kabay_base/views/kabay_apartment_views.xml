<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kabay_apartment_list" model="ir.ui.view"><field name="name">kabay.apartment.list</field><field name="model">kabay.apartment</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="condominium_id"/><field name="building_id"/><field name="floor"/><field name="unit_type"/><field name="active"/></list></field></record>
    <record id="view_kabay_apartment_form" model="ir.ui.view"><field name="name">kabay.apartment.form</field><field name="model">kabay.apartment</field><field name="arch" type="xml"><form><sheet><field name="active" invisible="1"/><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="code"/><field name="building_id"/><field name="condominium_id" readonly="1"/></group><group><field name="floor"/><field name="unit_type"/><field name="area"/><field name="coefficient"/><field name="photo_count" readonly="1"/></group></group><notebook><page string="Photos"><field name="photo_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="image" widget="image"/></list></field></page><page string="Notes"><field name="notes"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="view_kabay_apartment_search" model="ir.ui.view"><field name="name">kabay.apartment.search</field><field name="model">kabay.apartment</field><field name="arch" type="xml"><search><field name="name"/><field name="code"/><field name="condominium_id"/><field name="building_id"/><filter name="archived" string="Archived" domain="[('active','=',False)]"/></search></field></record>
    <record id="action_kabay_apartment" model="ir.actions.act_window"><field name="name">Apartments / Units</field><field name="res_model">kabay.apartment</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_kabay_apartment_search"/></record>
</odoo>
