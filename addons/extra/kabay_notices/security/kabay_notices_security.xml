<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_kabay_notice_company" model="ir.rule">
        <field name="name">Avisos Kabay: compañías autorizadas</field>
        <field name="model_id" ref="model_kabay_notice"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_kabay_notice_portal_recipient" model="ir.rule">
        <field name="name">Residentes: solo avisos dirigidos a su contacto</field>
        <field name="model_id" ref="model_kabay_notice"/>
        <field name="domain_force">[('recipient_ids.partner_id', '=', user.partner_id.id), ('recipient_ids.apartment_id.relation_ids.partner_id', '=', user.partner_id.id), ('recipient_ids.apartment_id.relation_ids.state', '=', 'confirmed'), ('recipient_ids.apartment_id.relation_ids.active', '=', True), ('state', '=', 'published')]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_kabay_notice_staff_public" model="ir.rule">
        <field name="name">Personal Kabay: avisos no personales de compañías autorizadas</field>
        <field name="model_id" ref="model_kabay_notice"/>
        <field name="domain_force">[('scope', '!=', 'contacts')]</field>
        <field name="groups" eval="[(4, ref('kabay_base.group_kabay_management')), (4, ref('kabay_base.group_kabay_finance')), (4, ref('kabay_base.group_kabay_reception')), (4, ref('kabay_base.group_kabay_maintenance'))]"/>
    </record>

    <record id="rule_kabay_notice_recipient_company" model="ir.rule">
        <field name="name">Destinatarios de avisos: compañías autorizadas</field>
        <field name="model_id" ref="model_kabay_notice_recipient"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_kabay_notice_recipient_portal_own" model="ir.rule">
        <field name="name">Residentes: solo sus propios registros de destinatario de aviso</field>
        <field name="model_id" ref="model_kabay_notice_recipient"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_kabay_notice_read_company" model="ir.rule">
        <field name="name">Lecturas de avisos: compañías autorizadas</field>
        <field name="model_id" ref="model_kabay_notice_read"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_kabay_notice_read_portal_own" model="ir.rule">
        <field name="name">Residentes: administrar solo sus propios acuses de lectura</field>
        <field name="model_id" ref="model_kabay_notice_read"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_kabay_notice_document_company" model="ir.rule">
        <field name="name">Archivos de avisos: compañías autorizadas</field>
        <field name="model_id" ref="model_kabay_notice_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_kabay_notice_document_portal_recipient" model="ir.rule">
        <field name="name">Residentes: descargar archivos solo de sus avisos</field>
        <field name="model_id" ref="model_kabay_notice_document"/>
        <field name="domain_force">[('notice_id.recipient_ids.partner_id', '=', user.partner_id.id), ('notice_id.recipient_ids.apartment_id.relation_ids.partner_id', '=', user.partner_id.id), ('notice_id.recipient_ids.apartment_id.relation_ids.state', '=', 'confirmed'), ('notice_id.recipient_ids.apartment_id.relation_ids.active', '=', True), ('notice_id.state', '=', 'published')]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_kabay_notice_residential_relation_portal_own" model="ir.rule">
        <field name="name">Portal: consultar relaciones residenciales vigentes propias para avisos</field>
        <field name="model_id" ref="kabay_residents.model_kabay_apartment_relation"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id), ('role', 'in', ['owner','tenant','authorized_resident']), ('state', '=', 'confirmed'), ('active', '=', True), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
