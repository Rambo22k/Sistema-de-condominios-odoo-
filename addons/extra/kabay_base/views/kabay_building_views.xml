<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kabay_building_list" model="ir.ui.view"><field name="name">kabay.building.list</field><field name="model">kabay.building</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="condominium_id"/><field name="apartment_count"/><field name="active"/></list></field></record>
    <record id="view_kabay_building_form" model="ir.ui.view"><field name="name">kabay.building.form</field><field name="model">kabay.building</field><field name="arch" type="xml"><form><sheet><field name="active" invisible="1"/><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><field name="code"/><field name="condominium_id"/><field name="apartment_count"/><field name="notes"/></group><field name="apartment_ids"><list editable="bottom"><field name="name"/><field name="code"/><field name="floor"/><field name="active"/></list></field></sheet><chatter/></form></field></record>
    <record id="action_kabay_building" model="ir.actions.act_window"><field name="name">Edificios / Torres</field><field name="res_model">kabay.building</field><field name="view_mode">list,form</field></record>
