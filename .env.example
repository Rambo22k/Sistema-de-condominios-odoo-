# Copy this file to .env and replace every example value before starting Docker.
POSTGRES_DB=kabay_dev
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE-ME-USE-A-LONG-RANDOM-VALUE

# Host bind address defaults to loopback; keep it private for local demos.
BIND_ADDRESS=127.0.0.1
ODOO_PORT=18020
ODOO_EVENTED_PORT=16020
POSTGRES_PORT=15220

# Set this to the licensed Odoo 19 Enterprise addons directory on this machine.
# Windows paths should use forward slashes, for example C:/Odoo/enterprise-19.0.
ODOO_ENTERPRISE_ADDONS_PATH=C:/path/to/licensed/enterprise-19.0

# Optional image overrides; defaults are defined in compose.yaml.
# ODOO_IMAGE=odoo:19.0
# POSTGRES_IMAGE=pgvector/pgvector:pg17
