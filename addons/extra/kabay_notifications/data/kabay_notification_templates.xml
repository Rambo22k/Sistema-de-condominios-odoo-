<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_kabay_billing" model="mail.template">
        <field name="name">Kabay — Facturación</field><field name="model_id" ref="model_kabay_notification"/>
        <field name="subject">{{ object.email_subject }}</field><field name="email_to">{{ object.recipient_id.email }}</field>
        <field name="body_html" type="html"><div><t t-out="object.email_body_html"/></div></field><field name="auto_delete">True</field>
    </record>
