<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_kabay_financing_contract_company" model="ir.rule">
        <field name="name">Kabay financing contracts by company</field>
        <field name="model_id" ref="model_kabay_financing_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_kabay_financing_installment_company" model="ir.rule">
        <field name="name">Kabay financing installments by company</field>
        <field name="model_id" ref="model_kabay_financing_installment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
