<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_kabay_deposit_resident" model="res.groups">
        <field name="name">Kabay / Residente portal de depósitos</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_kabay_deposit_resident_own" model="ir.rule">
        <field name="name">Residentes: consultar sus propias declaraciones de depósito</field>
        <field name="model_id" ref="model_kabay_deposit_declaration"/>
        <field name="domain_force">[('declarant_partner_id', '=', user.partner_id.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_kabay_deposit_resident'))]"/>
    </record>
    <record id="rule_kabay_deposit_finance_company" model="ir.rule">
        <field name="name">Finanzas: consultar declaraciones de depósito de compañías autorizadas</field>
        <field name="model_id" ref="model_kabay_deposit_declaration"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('kabay_base.group_kabay_finance')), (4, ref('kabay_base.group_kabay_manager')), (4, ref('kabay_base.group_kabay_management'))]"/>
    </record>

    <record id="rule_kabay_deposit_allocation_resident_own" model="ir.rule">
        <field name="name">Residentes: consultar sus propias imputaciones de depósito</field>
        <field name="model_id" ref="model_kabay_deposit_allocation"/>
        <field name="domain_force">[('declaration_id.declarant_partner_id', '=', user.partner_id.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_kabay_deposit_resident'))]"/>
    </record>
    <record id="rule_kabay_deposit_allocation_staff_company" model="ir.rule">
        <field name="name">Personal: consultar imputaciones de depósito de compañías autorizadas</field>
        <field name="model_id" ref="model_kabay_deposit_allocation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('kabay_base.group_kabay_finance')), (4, ref('kabay_base.group_kabay_manager')), (4, ref('kabay_base.group_kabay_management'))]"/>
    </record>

    <record id="rule_kabay_deposit_resident_relation_own_current" model="ir.rule">
        <field name="name">Portal: consultar únicamente relaciones vigentes de apartamentos propios</field>
        <field name="model_id" ref="kabay_residents.model_kabay_apartment_relation"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id), ('role', 'in', ['owner', 'tenant', 'authorized_resident']), ('state', '=', 'confirmed'), ('active', '=', True), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_kabay_deposit_resident'))]"/>
    </record>
</odoo>
