    <record id="view_kabay_resp_list" model="ir.ui.view"><field name="name">kabay.payment.responsibility.list</field><field name="model">kabay.payment.responsibility</field><field name="arch" type="xml"><list><field name="apartment_id"/><field name="fee_rule_id"/><field name="partner_id"/><field name="date_start"/><field name="date_end"/><field name="state"/></list></field></record>
    <record id="view_kabay_resp_form" model="ir.ui.view"><field name="name">kabay.payment.responsibility.form</field><field name="model">kabay.payment.responsibility</field><field name="arch" type="xml"><form><sheet><group><field name="apartment_id"/><field name="fee_rule_id"/><field name="partner_id"/><field name="date_start"/><field name="date_end"/><field name="state"/><field name="active"/></group><chatter/></sheet></form></field></record>
    <record id="view_kabay_resp_search" model="ir.ui.view"><field name="name">kabay.payment.responsibility.search</field><field name="model">kabay.payment.responsibility</field><field name="arch" type="xml"><search><field name="apartment_id"/><field name="fee_rule_id"/><field name="partner_id"/><field name="state"/><filter name="group_apartment" string="Apartamento" context="{'group_by':'apartment_id'}"/><filter name="group_partner" string="Responsable" context="{'group_by':'partner_id'}"/></search></field></record>
    <record id="view_kabay_batch_list" model="ir.ui.view"><field name="name">kabay.billing.batch.list</field><field name="model">kabay.billing.batch</field><field name="arch" type="xml"><list><field name="name"/><field name="condominium_id"/><field name="period_start"/><field name="period_end"/><field name="invoice_date"/><field name="due_date"/><field name="ready_count"/><field name="invoice_count"/><field name="total_expected"/><field name="state"/></list></field></record>
