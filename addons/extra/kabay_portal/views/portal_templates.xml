<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_kabay" inherit_id="portal.portal_my_home" name="Kabay resident home entry">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal/static/src/img/portal-connection.svg'"/>
                <t t-set="title">Inicio Kabay</t><t t-set="text">Resumen de tus unidades, avisos y cuenta</t>
                <t t-set="url" t-value="'/my/kabay'"/><t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>
    <template id="portal_nav" name="Kabay portal navigation">
        <div class="kabay-shell">
            <header class="kabay-topbar">
                <a class="kabay-brand" href="/my/kabay"><span class="kabay-mark">⌂</span><span><b>Kabay Group</b><small>Portal de residentes</small></span></a>
                <div class="kabay-user"><span t-esc="kabay_resident.name"/><a href="/my/kabay/profile">Mi perfil</a><a href="/web/session/logout?redirect=/web/login">Salir</a></div>
            </header>
            <nav class="kabay-nav" aria-label="Navegación de residentes">
                <a href="/my/kabay" t-att-class="'active' if page_name == 'kabay_home' else ''">Inicio</a>
                <a href="/my/kabay/units" t-att-class="'active' if page_name == 'kabay_units' else ''">Mis unidades</a>
                <a href="/my/kabay/invoices" t-att-class="'active' if page_name == 'kabay_invoices' else ''">Facturas</a>
                <a href="/my/kabay/financing" t-att-class="'active' if page_name == 'kabay_financing' else ''">Financiamiento</a>
                <a href="/my/kabay/deposits">Depósitos</a>
                <a href="/my/kabay/notices">Avisos</a>
                <a href="/my/kabay/tickets">Solicitudes</a>
            </nav>
            <main class="kabay-content"><t t-out="0"/></main>
            <footer class="kabay-footer">Kabay Group · Gestión residencial</footer>
        </div>
    </template>
    <template id="portal_dashboard" name="Kabay resident dashboard">
        <t t-call="portal.portal_layout">
            <t t-call="kabay_portal.portal_nav">
                <section class="kabay-welcome"><div><span class="kabay-eyebrow">TU COMUNIDAD EN UN SOLO LUGAR</span><h1>¡Bienvenido, <t t-esc="kabay_resident.name"/>!</h1><p>Consulta tus unidades y mantente al día con la comunidad.</p></div><a class="kabay-button" href="/my/kabay/tickets/new">Nueva solicitud <span>→</span></a></section>
                <section class="kabay-stats">
                    <article><small>Unidades autorizadas</small><strong t-esc="len(units)"/><a href="/my/kabay/units">Consultar unidades →</a></article>
                    <article><small>Saldo abierto consultable</small><strong><span t-esc="open_balance" t-options="{'widget': 'monetary', 'display_currency': currency}"/></strong><a href="/my/kabay/invoices">Ver facturas →</a></article>
                    <article><small>Solicitudes recientes</small><strong t-esc="len(tickets)"/><a href="/my/kabay/tickets">Ver solicitudes →</a></article>
                </section>
                <section class="kabay-section"><div class="kabay-section-head"><div><span class="kabay-eyebrow">MIS ESPACIOS</span><h2>Unidades autorizadas</h2></div><a href="/my/kabay/units">Ver todas</a></div>
                    <div class="kabay-grid" t-if="units"><t t-foreach="relations" t-as="relation"><article class="kabay-card"><div class="kabay-card-top"><span class="kabay-icon">⌂</span><span class="kabay-pill" t-esc="role_labels.get(relation.role)"/></div><h3 t-esc="relation.apartment_id.code or relation.apartment_id.name"/><p t-esc="relation.apartment_id.condominium_id.name"/><small><t t-esc="relation.apartment_id.building_id.name"/> · Piso <t t-esc="relation.apartment_id.floor or '—'"/></small><a class="kabay-link" t-att-href="'/my/kabay/units/%s' % relation.apartment_id.id">Abrir ficha <span>→</span></a></article></t></div>
                    <div class="kabay-empty" t-else="">No tienes unidades con una relación vigente. Contacta a administración para revisar tu acceso.</div>
                </section>
                <div class="kabay-two-col"><section class="kabay-section"><div class="kabay-section-head"><div><span class="kabay-eyebrow">COMUNIDAD</span><h2>Avisos recientes</h2></div><a href="/my/kabay/notices">Ver avisos</a></div><t t-foreach="notices" t-as="notice"><a class="kabay-list-row" t-att-href="'/my/kabay/notices/%s' % notice.id"><span class="kabay-dot"/><span><b t-esc="notice.name"/><small t-esc="notice.publish_datetime"/></span><span class="kabay-arrow">→</span></a></t><div class="kabay-empty" t-if="not notices">No hay avisos vigentes para tus unidades.</div></section>
                    <section class="kabay-section"><div class="kabay-section-head"><div><span class="kabay-eyebrow">SEGUIMIENTO</span><h2>Mis solicitudes</h2></div><a href="/my/kabay/tickets">Ver solicitudes</a></div><t t-foreach="tickets" t-as="ticket"><a class="kabay-list-row" t-att-href="'/my/kabay/tickets/%s' % ticket.id"><span class="kabay-icon small">◷</span><span><b t-esc="ticket.name"/><small t-esc="ticket.kabay_apartment_id.code"/></span><span class="kabay-pill" t-esc="ticket_state_labels.get(ticket.kabay_state)"/></a></t><div class="kabay-empty" t-if="not tickets">Todavía no tienes solicitudes.</div></section></div>
                <section class="kabay-quick"><a href="/my/kabay/deposits/new"><span>↓</span><b>Reportar depósito</b><small>Enviar un comprobante para revisión</small></a><a href="/my/kabay/financing"><span>◷</span><b>Financiamiento</b><small>Revisar contratos y cuotas propias</small></a><a href="/my/kabay/notices"><span>✉</span><b>Avisos</b><small>Comunicados de tu comunidad</small></a><a href="/my/kabay/tickets/new"><span>＋</span><b>Nueva solicitud</b><small>Contactar a administración</small></a></section>
            </t>
        </t>
    </template>
    <template id="portal_units" name="Kabay resident units">
        <t t-call="portal.portal_layout"><t t-call="kabay_portal.portal_nav"><section class="kabay-page-head"><span class="kabay-eyebrow">TU RESIDENCIA</span><h1>Mis unidades</h1><p>Unidades vinculadas a una relación vigente de tu cuenta.</p></section><div class="kabay-grid" t-if="relations"><t t-foreach="relations" t-as="relation"><article class="kabay-card"><div class="kabay-card-top"><span class="kabay-icon">⌂</span><span class="kabay-pill" t-esc="role_labels.get(relation.role)"/></div><h2 t-esc="relation.apartment_id.code or relation.apartment_id.name"/><p t-esc="relation.apartment_id.condominium_id.name"/><small><t t-esc="relation.apartment_id.building_id.name"/> · Piso <t t-esc="relation.apartment_id.floor or '—'"/></small><a class="kabay-link" t-att-href="'/my/kabay/units/%s' % relation.apartment_id.id">Ver detalles →</a></article></t></div><div class="kabay-empty" t-else="">No hay unidades vigentes asociadas a tu usuario.</div></t></t>
    </template>
    <template id="portal_unit_detail" name="Kabay apartment detail">
        <t t-call="portal.portal_layout"><t t-call="kabay_portal.portal_nav"><a class="kabay-back" href="/my/kabay/units">← Mis unidades</a><section class="kabay-page-head"><span class="kabay-eyebrow">FICHA DE UNIDAD</span><h1 t-esc="apartment.code or apartment.name"/><p><t t-esc="apartment.condominium_id.name"/> · <t t-esc="apartment.building_id.name"/></p></section><div class="kabay-detail-grid"><section class="kabay-section"><h2>Información general</h2><dl class="kabay-dl"><dt>Condominio</dt><dd t-esc="apartment.condominium_id.name"/><dt>Torre / edificio</dt><dd t-esc="apartment.building_id.name"/><dt>Piso</dt><dd t-esc="apartment.floor or '—'"/><dt>Tipo</dt><dd t-esc="apartment.unit_type or '—'"/><dt>Tu relación</dt><dd t-esc="role_label"/></dl></section><section class="kabay-section"><h2>Accesos de esta unidad</h2><a class="kabay-list-row" t-att-href="'/my/kabay/invoices?apartment_id=%s' % apartment.id">Facturas y saldo <span>→</span></a><a class="kabay-list-row" t-att-href="'/my/kabay/deposits/new?apartment_id=%s' % apartment.id">Reportar depósito <span>→</span></a><a class="kabay-list-row" href="/my/kabay/tickets">Mis solicitudes <span>→</span></a><a class="kabay-list-row" href="/my/kabay/financing">Financiamiento <span>→</span></a></section></div><section class="kabay-section" t-if="photos"><h2>Fotografías autorizadas</h2><div class="kabay-photo-grid"><img t-foreach="photos" t-as="photo" t-att-src="'/my/kabay/units/%s/photo/%s' % (apartment.id, photo.id)" t-att-alt="photo.name" loading="lazy"/></div></section></t></t>
    </template>
    <template id="portal_invoices" name="Kabay resident invoices">
        <t t-call="portal.portal_layout"><t t-call="kabay_portal.portal_nav"><section class="kabay-page-head"><span class="kabay-eyebrow">ESTADO DE CUENTA</span><h1>Facturas pendientes</h1><p>Mostramos únicamente cargos abiertos que el módulo de depósitos autoriza para ti. Los depósitos reportados no reducen estos saldos.</p></section><form class="kabay-filter" method="get"><label>Unidad<select name="apartment_id"><option value="">Todas</option><option t-foreach="units" t-as="unit" t-att-value="unit.id" t-att-selected="str(unit.id) == str(selected)" t-esc="unit.code or unit.name"/></select></label><button class="kabay-button" type="submit">Filtrar</button></form><section class="kabay-section"><div class="kabay-table-wrap"><table class="kabay-table"><thead><tr><th>Número de factura</th><th>Apartamento</th><th>Vencimiento</th><th>Saldo</th><th>Estado</th></tr></thead><tbody><tr t-foreach="invoices" t-as="invoice"><td t-esc="invoice['label']"/><td t-esc="invoice['apartment'].code or invoice['apartment'].name"/><td t-esc="invoice['due_date'] or '—'"/><td><span t-esc="invoice['residual']"/> <span t-esc="invoice['currency']"/></td><td><span class="kabay-pill warning">Pendiente</span></td></tr><tr t-if="not invoices"><td colspan="5" class="kabay-empty-cell">No hay facturas pendientes visibles para los criterios seleccionados.</td></tr></tbody></table></div></section></t></t>
    </template>
    <template id="portal_financing" name="Kabay resident financing">
        <t t-call="portal.portal_layout"><t t-call="kabay_portal.portal_nav"><section class="kabay-page-head"><span class="kabay-eyebrow">COMPRA FINANCIADA</span><h1>Mi financiamiento</h1><p>Consulta fechas de vencimiento, días de gracia, pagos conciliados y saldos en mora.</p></section><t t-foreach="contracts" t-as="contract"><section class="kabay-section"><div class="kabay-section-head"><div><h2 t-esc="contract.name"/><p t-esc="contract.apartment_id.code"/></div><span class="kabay-pill" t-esc="contract.progress_label"/></div><div class="kabay-stats compact"><article><small>Precio de compra</small><strong t-esc="contract.purchase_price" t-options="{'widget': 'monetary', 'display_currency': contract.currency_id}"/></article><article><small>Inicial</small><strong t-esc="contract.down_payment" t-options="{'widget': 'monetary', 'display_currency': contract.currency_id}"/></article><article><small>Saldo facturado</small><strong t-esc="contract.account_residual" t-options="{'widget': 'monetary', 'display_currency': contract.currency_id}"/></article><article><small>Cuotas pagadas / total</small><strong><t t-esc="contract.paid_installments"/> / <t t-esc="contract.total_installments"/></strong></article></div><div class="kabay-progress"><span t-attf-style="width: #{100.0 * contract.paid_installments / contract.total_installments if contract.total_installments else 0}%"/></div><div class="kabay-table-wrap"><table class="kabay-table"><thead><tr><th>Cuota</th><th>Día de pago</th><th>Gracia hasta</th><th>Importe</th><th>Número de factura</th><th>Fecha de pago</th><th>Estado del pago</th><th>Días en mora</th><th>Saldo en mora</th><th>Saldo</th></tr></thead><tbody><tr t-foreach="contract.installment_ids" t-as="line"><td t-esc="line.number"/><td t-esc="line.due_date"/><td t-esc="line.grace_end_date"/><td><span t-esc="line.amount_total" t-options="{'widget': 'monetary', 'display_currency': contract.currency_id}"/></td><td><t t-if="line.invoice_number" t-esc="line.invoice_number"/><t t-elif="line.invoice_id">Borrador, número oficial al publicar</t><t t-else="">Aún no facturada</t></td><td t-esc="line.payment_date or '—'"/><td t-esc="payment_timing_labels.get(line.payment_timing)"/><td t-esc="line.days_in_arrears"/><td><span t-esc="line.balance_in_arrears" t-options="{'widget': 'monetary', 'display_currency': contract.currency_id}"/></td><td><span t-esc="line.balance" t-options="{'widget': 'monetary', 'display_currency': contract.currency_id}"/></td></tr></tbody></table></div></section></t><div class="kabay-empty" t-if="not contracts">No hay financiamientos activos a tu nombre para tus unidades actuales.</div></t></t>
    </template>
    <template id="portal_profile" name="Kabay resident profile">
        <t t-call="portal.portal_layout"><t t-call="kabay_portal.portal_nav"><section class="kabay-page-head"><span class="kabay-eyebrow">TU CUENTA</span><h1>Mi perfil</h1><p>Actualiza tus datos básicos de contacto. Los roles y unidades se administran desde Kabay.</p></section><section class="kabay-section kabay-form-panel"><div class="kabay-alert success" t-if="saved">Tus datos se actualizaron.</div><div class="kabay-alert error" t-if="error" t-esc="error"/><form method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label>Nombre<input name="name" required="required" t-att-value="partner.name"/></label><label>Correo electrónico<input name="email" type="email" t-att-value="partner.email or ''"/></label><label>Teléfono<input name="phone" t-att-value="partner.phone or ''"/></label><button class="kabay-button" type="submit">Guardar cambios</button></form><a href="/my/security">Cambiar contraseña →</a></section></t></t>
    </template>
</odoo>
