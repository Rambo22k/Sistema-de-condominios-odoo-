<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kabay_fee_rule_list" model="ir.ui.view"><field name="name">kabay.fee.rule.list</field><field name="model">kabay.fee.rule</field><field name="arch" type="xml"><list><field name="name"/><field name="condominium_id"/><field name="building_id"/><field name="concept"/><field name="amount"/><field name="currency_id"/><field name="periodicity"/><field name="date_start"/><field name="date_end"/><field name="active"/></list></field></record>
